{
  "manifest_version": 3,
  "name": "ML2Sheets",
  "version": "1.0",
  "description": "Chrome extension to send MercadoLibre product data to Google Sheets 🪙",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ML2Sheets"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "commands"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "send-data": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Send product data to Google Sheets 🪙"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolibre.com/*",
        "*://*.mercadolibre.com.ar/*"
      ],
      "js": [
        "scraper.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}